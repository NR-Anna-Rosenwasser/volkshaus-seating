# Copy to .env. All variables the app reads are listed here.
# DDEV rewrites APP_URL and the DB_* values in its own .env on `ddev start`.

APP_NAME="Volkshaus Sitzplatzwahl"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://plaetze.example.ch
APP_TIMEZONE=Europe/Zurich
APP_LOCALE=de_CH
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH
APP_MAINTENANCE_DRIVER=file

# Host port for CloudPanel's reverse proxy (published on 127.0.0.1 only).
APP_PORT=8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=seating
DB_USERNAME=seating
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mailgun in production, e.g. MAIL_HOST=smtp.eu.mailgun.org
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="${APP_NAME}"
# Maximum outgoing emails per second.
MAIL_PER_SECOND=5
# Shown to buyers for changes after the deadline.
CONTACT_EMAIL=

# Filament admin, created by `php artisan db:seed`.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Hi.Events
HIEVENTS_BASE_URL=
HIEVENTS_API_KEY=
HIEVENTS_WEBHOOK_SECRET=
HIEVENTS_EVENT_ID=
# Comma-separated product ids.
SEATED_PRODUCT_IDS=
# Comma-separated ids of the order questions that ask for a wheelchair place.
WHEELCHAIR_QUESTION_IDS=
# Comma-separated addresses that are told about wheelchair requests.
WHEELCHAIR_NOTIFY_EMAILS=

# Event schedule, local time (Europe/Zurich), e.g. 2027-02-13 20:00
EVENT_NAME=
EVENT_DATE=
DOORS_AT=
SELECTION_OPENS_AT=
SELECTION_DEADLINE=
REMINDER_OFFSETS_DAYS=14,7,2
FINAL_MAIL_OFFSET_DAYS=2

# Days after EVENT_DATE until personal data is anonymized. The selection page promises 30.
PURGE_AFTER_DAYS=30
# Nightly dumps. Docker Compose sets BACKUP_PATH to its own volume.
BACKUP_KEEP_DAYS=14

# Comma-separated addresses for system alerts.
ADMIN_EMAILS=
# Failed emails per hour before an alert goes out.
MAIL_FAILURE_THRESHOLD=5
